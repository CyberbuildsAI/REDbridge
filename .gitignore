# .NET
bin/
obj/
*.user
*.suo
.vs/
*.binlog
artifacts/
dist/

# never commit game files, WolvenKit binaries, or data extracted from the game
*.archive
*.dll
*.exe
rtti-dump*

# build output of the bridge
src/**/bin/
src/**/obj/

# WolvenKit's source, fetched for reading by npm run wolvenkit:source; the build uses its NuGet packages
external/

# probe output written by tools/probe.py
probe-out/

# npm wrapper has no dependencies, but keep the folder out anyway
node_modules/

# python
__pycache__/
